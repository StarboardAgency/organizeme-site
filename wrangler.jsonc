{
  // Cloudflare Worker that serves the Organize Me! site and handles the contact form.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "organizeme-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Run the Worker first so it can redirect www -> bare domain and handle /api/contact.
    "run_worker_first": true
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "vars": {
    "CONTACT_TO": "jenn@organizeme.org, jenn.agnew@icloud.com",
    "MAIL_FROM": "website@organizeme.org"
  },
  "observability": { "enabled": true }
}
